#!/usr/bin/env sh
set -e

echo "→ Migration journal integrity"
bash scripts/check-migrations.sh

echo "→ Typecheck (pnpm typecheck, all workspaces)"
pnpm typecheck

echo "→ Lint (eslint, max-warnings 0)"
pnpm lint

echo "→ Unit tests (Vitest)"
pnpm test:unit

# E2E (Playwright) are intentionally NOT in the pre-push gate — they take
# minutes and belong in CI (qa.yml e2e-mock). Run them locally on demand with
# `PRE_PUSH_FULL=1 git push …` or `pnpm ci:repro`.
if [ "${PRE_PUSH_FULL:-0}" = "1" ]; then
  echo "→ Full CI repro (mirrors qa.yml e2e-mock)"
  pnpm ci:repro
else
  echo "✓ Fast gates passed. (PRE_PUSH_FULL=1 git push … to also run ci:repro.)"
fi
