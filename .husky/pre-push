#!/usr/bin/env sh
set -e

echo "→ Migration journal integrity"
bash scripts/check-migrations.sh

echo "→ Typecheck (pnpm typecheck, all workspaces)"
pnpm typecheck

echo "→ Lint (eslint, max-warnings 0)"
pnpm lint

echo "→ Unit tests (Vitest)"
pnpm test:unit

# Husky pipes "<local_ref> <local_sha> <remote_ref> <remote_sha>" on stdin.
# We sniff for refs/heads/main to trigger the full CI repro on main pushes.
pushed_refs=$(cat || true)
pushing_main=0
case "$pushed_refs" in
  *refs/heads/main*) pushing_main=1 ;;
esac

if [ "$pushing_main" = "1" ] || [ "${PRE_PUSH_FULL:-0}" = "1" ]; then
  echo "→ Full CI repro (mirrors qa.yml e2e-mock)"
  pnpm ci:repro
else
  echo "✓ Fast gates passed. (Push to main or PRE_PUSH_FULL=1 to also run ci:repro.)"
fi
