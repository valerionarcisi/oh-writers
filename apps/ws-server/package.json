{
  "name": "@oh-writers/ws-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../web/.env src/index.ts",
    "build": "echo 'ws-server runs via tsx; no build step (no deploy target yet — see infra/08b)'",
