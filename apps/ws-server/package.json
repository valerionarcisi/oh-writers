    "@oh-writers/utils": "workspace:*",
    "drizzle-orm": "0.45.1",
    "hono": "4.12.2",
    "ioredis": "5.9.3",
    "lib0": "0.2.117",
    "neverthrow": "8.2.0",
    "ws": "8.18.0",
    "y-protocols": "1.0.7",
    "y-websocket": "1.5.4",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
