# ─────────────────────────────────────────────────────────────────────────────
# apps/web/.env — single source of truth for all environment variables.
#
# Vinxi reads this file automatically.
# Scripts (drizzle-kit, migrations) source it via scripts/_load-env.sh.
#
# Copy to apps/web/.env and fill in the secrets before running pnpm dev:up.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://oh-writers:oh-writers@localhost:5432/oh-writers_dev

# Redis
REDIS_URL=redis://localhost:6379
# Use Redis as Better Auth's secondary session store. OPT-IN: only enable for a
# multi-instance ws-server that needs a shared fast session lookup. When unset,
# sessions persist in the Postgres primary store (robust single-instance default).
# AUTH_USE_REDIS=true

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# WebSocket server
WS_PORT=1234
WS_SECRET=change-me-in-production-min-32-chars

# Google Places API — used by Cesare for agentic location scouting
# Get a key at https://console.cloud.google.com (Places API New must be enabled)
# Cost: ~$0.017 per Text Search request. Leave empty to disable scouting.
GOOGLE_PLACES_API_KEY=

# Langfuse — AI observability (traces, token usage, tool calls)
# Get keys at https://cloud.langfuse.com (free Hobby tier: 50K units/month)
# Leave empty to disable OTEL tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── AI feature flags ──────────────────────────────────────────────────────────
# MOCK_AI=true          → use fixture responses for one-shot completions AND
#                         a scripted scenario-based mock for the Cesare
#                         agentic tool loop. Tool executors still run against
#                         the real DB. See
#                         apps/web/app/features/predictions/_mocks/cesare-tool-loop.mock.ts
#                         for the scenario library. Test-only mock context can
#                         be seeded via POST /api/test/mock-context.
# LLM_FIRST_BREAKDOWN=true → enable Sonnet full-script breakdown (costs tokens)
MOCK_AI=true
LLM_FIRST_BREAKDOWN=false

# ── AI cost guard (Spec 83) ──────────────────────────────────────────────────
# Daily spend caps in USD (UTC day), enforced before every model call and
# recorded in the ai_usage ledger (`pnpm ai:costs` for the report).
# Background = ambient flows (scene summaries, bible distill); over-budget
# background calls are skipped silently, user calls surface a typed error.
AI_DAILY_BUDGET_USD=5
AI_DAILY_BUDGET_BACKGROUND_USD=1

# ── BYOK provider key encryption (Spec 84) ────────────────────────────────────
# AES-256-GCM key material for encrypting per-user AI provider API keys at
# rest (packages/db ai_providers.api_key_encrypted). Required at call time —
# saving/reading a provider key without it fails with a typed error.
# Generate with: openssl rand -base64 32
AI_KEY_ENCRYPTION_SECRET=

# ── Dev-only auth bypass ──────────────────────────────────────────────────────
# DEV_AUTH_BYPASS=true → skip Better Auth and run every request as the seeded
#                        Test User (owner of the "Non fa ridere" seed project).
#                        Lets Playwright / Chrome drive the app without login.
#                        SERVER-ONLY, NEVER exposed to the client. Ignored when
#                        NODE_ENV=production. Keep OFF here; set it only in
#                        .env.local or the Playwright launch env. Never set it
#                        in any production/deploy environment.
DEV_AUTH_BYPASS=false
