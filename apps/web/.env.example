# ─────────────────────────────────────────────────────────────────────────────
# apps/web/.env — single source of truth for all environment variables.
#
# Vinxi reads this file automatically.
# Scripts (drizzle-kit, migrations) source it via scripts/_load-env.sh.
#
# Copy to apps/web/.env and fill in the secrets before running pnpm dev:up.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://oh-writers:oh-writers@localhost:5432/oh-writers_dev

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# WebSocket server
WS_PORT=1234
WS_SECRET=change-me-in-production-min-32-chars

# Google Places API — used by Cesare for agentic location scouting
# Get a key at https://console.cloud.google.com (Places API New must be enabled)
# Cost: ~$0.017 per Text Search request. Leave empty to disable scouting.
GOOGLE_PLACES_API_KEY=

# ── AI feature flags ──────────────────────────────────────────────────────────
# MOCK_AI=true          → use fixture responses for one-shot completions AND
#                         a scripted scenario-based mock for the Cesare
#                         agentic tool loop. Tool executors still run against
#                         the real DB. See
#                         apps/web/app/features/predictions/_mocks/cesare-tool-loop.mock.ts
#                         for the scenario library. Test-only mock context can
#                         be seeded via POST /api/test/mock-context.
# LLM_FIRST_BREAKDOWN=true → enable Sonnet full-script breakdown (costs tokens)
MOCK_AI=false
LLM_FIRST_BREAKDOWN=false
