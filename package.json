{
  "name": "oh-writers",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:up:langfuse": "bash scripts/dev-up-langfuse.sh",
    "dev:down:langfuse": "bash scripts/dev-down-langfuse.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev:nuke": "bash scripts/dev-nuke.sh",
    "dev:check": "bash scripts/dev-check.sh",
    "fleet:check": "bash scripts/fleet-check.sh",
    "ci:repro": "bash scripts/ci-repro.sh",
    "check:migrations": "bash scripts/check-migrations.sh",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint apps/web/app --max-warnings 0",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:unit": "pnpm --filter @oh-writers/web --filter @oh-writers/ws-server test:unit",
    "db:migrate": "pnpm --filter @oh-writers/db migrate",
    "db:migrate:create": "pnpm --filter @oh-writers/db migrate:create",
    "db:migrate:status": "pnpm --filter @oh-writers/db migrate:status",
    "db:seed": "pnpm --filter @oh-writers/db seed && pnpm --filter @oh-writers/web seed:yjs",
    "db:studio": "pnpm --filter @oh-writers/db studio",
    "db:psql": "docker compose -f docker/docker-compose.dev.yml exec postgres psql -U oh-writers oh-writers_dev",
    "db:backup": "bash scripts/backup-dev-db.sh",
    "dev:session": "bash scripts/dev-session.sh",
    "test:setup": "bash scripts/test-db-setup.sh",
    "db:seed:reset": "pnpm --filter @oh-writers/db seed:reset && pnpm --filter @oh-writers/web seed:yjs",
    "test:fixtures:pdf": "tsx scripts/generate-test-pdfs.ts",
    "vernissage:walk": "tsx scripts/vernissage-walk.ts --target=test",
    "vernissage:scaffold": "tsx scripts/vernissage-scaffold.ts",
    "cost:smoke:cesare": "tsx scripts/cost-smoke-cesare.ts",
    "cost:smoke:narrative-grounding": "tsx scripts/cost-smoke-narrative-grounding.ts",
    "cost:smoke:location-normalise": "tsx scripts/cost-smoke-location-normalise.ts",
    "cost:smoke:location-rank": "tsx scripts/cost-smoke-location-rank.ts",
    "cost:smoke:scene-summary": "tsx scripts/cost-smoke-scene-summary.ts",
    "cost:smoke:bible": "tsx scripts/cost-smoke-bible.ts",
    "ai:costs": "tsx scripts/ai-costs.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oh-writers/db": "workspace:*",
    "@playwright/test": "1.58.2",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "10.0.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "drizzle-orm": "0.45.1",
    "husky": "^9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.8.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "zod"
      ]
    },
    "packageExtensions": {
      "drizzle-orm@*": {
        "peerDependenciesMeta": {
          "@opentelemetry/api": {
            "optional": true
          }
        }
      }
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "dependencies": {
    "react-aria": "3.48.0",
    "react-stately": "3.46.0"
  }
}
