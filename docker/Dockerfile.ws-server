# Render can't select a --target stage from a shared multi-stage Dockerfile
# (no native support as of writing), so this and Dockerfile.web each keep
# their own copy, ending at the stage they need as the LAST stage — that's
# what a target-less `docker build` picks. Keep both files' shared stages
# (base/deps/builder) in sync with docker/Dockerfile by hand; if this drifts
# often, consider a `docker build --target` capable host instead.
FROM node:22-alpine AS base
RUN corepack enable pnpm
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/db/package.json packages/db/
COPY packages/auth/package.json packages/auth/
COPY packages/domain/package.json packages/domain/
COPY packages/utils/package.json packages/utils/
COPY packages/ui/package.json packages/ui/
COPY apps/web/package.json apps/web/
COPY apps/ws-server/package.json apps/ws-server/
RUN pnpm install --frozen-lockfile

# Build packages — @oh-writers/domain, @oh-writers/utils and @oh-writers/ui
# ship raw TS source (no build script); consumers (vinxi, tsup) compile it
# themselves. Only @oh-writers/db has a real build step.
FROM deps AS builder
COPY . .
RUN pnpm --filter @oh-writers/db build

# WS server — the compiled bundle inlines @oh-writers/domain and
# @oh-writers/utils (see apps/ws-server/tsup.config.ts noExternal) but
# leaves real npm deps (hono, ws, ioredis, yjs...) and the workspace-linked
# @oh-writers/db external, so both node_modules (pnpm symlinks resolved)
# and the built @oh-writers/db dist must ship alongside the bundle. Must
# be LAST so a target-less `docker build` picks it as the final image.
FROM builder AS ws-builder
RUN pnpm --filter @oh-writers/ws-server build
RUN pnpm --filter @oh-writers/ws-server --prod --no-optional deploy --legacy /app/ws-server-deploy
RUN mkdir -p /app/ws-server-deploy/node_modules/@oh-writers/db/dist \
    && cp -r /app/packages/db/dist/. /app/ws-server-deploy/node_modules/@oh-writers/db/dist/

FROM node:22-alpine AS ws-server
WORKDIR /app
COPY --from=ws-builder /app/ws-server-deploy/node_modules ./node_modules
COPY --from=ws-builder /app/apps/ws-server/dist ./
EXPOSE 1234
CMD ["node", "index.js"]
