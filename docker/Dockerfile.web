# Render can't select a --target stage from a shared multi-stage Dockerfile
# (no native support as of writing), so this and Dockerfile.ws-server each
# keep their own copy, ending at the stage they need as the LAST stage —
# that's what a target-less `docker build` picks. Keep both files' shared
# stages (base/deps/builder) in sync with docker/Dockerfile by hand; if this
# drifts often, consider a `docker build --target` capable host instead.
FROM node:22-alpine AS base
RUN corepack enable pnpm
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/db/package.json packages/db/
COPY packages/auth/package.json packages/auth/
COPY packages/domain/package.json packages/domain/
COPY packages/utils/package.json packages/utils/
COPY packages/ui/package.json packages/ui/
COPY apps/web/package.json apps/web/
COPY apps/ws-server/package.json apps/ws-server/
RUN pnpm install --frozen-lockfile

# Build packages — @oh-writers/domain, @oh-writers/utils and @oh-writers/ui
# ship raw TS source (no build script); consumers (vinxi, tsup) compile it
# themselves. Only @oh-writers/db has a real build step.
FROM deps AS builder
COPY . .
RUN pnpm --filter @oh-writers/db build

# Web app — the only stage this file needs; must be LAST so a target-less
# `docker build` picks it as the final image.
FROM builder AS web-builder
RUN pnpm --filter @oh-writers/web build
# drizzle-kit ships in this image (not just its dist) because Render's
# preDeployCommand runs `pnpm --filter @oh-writers/db migrate` inside this
# same built image, ahead of the app going live — see render.yaml.
RUN pnpm --filter @oh-writers/db deploy --legacy /app/db-deploy

FROM node:22-alpine AS web
RUN corepack enable pnpm
WORKDIR /app
COPY --from=web-builder /app/apps/web/.output ./
COPY --from=web-builder /app/db-deploy ./db-deploy
EXPOSE 3000
CMD ["node", "server/index.mjs"]
